# Copy to backend/.env only for a local/staging PostGIS instance.
APP_ENV="development"
APP_DEBUG=true
DATABASE_URL="postgresql+psycopg://crop_advisory:replace-with-a-strong-password@127.0.0.1:5432/crop_advisory"
SECRET_KEY="replace-with-a-random-development-secret"
FRONTEND_ALLOWED_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"
INGESTION_PROVIDER="mock"
SMS_PROVIDER="mock"
ML_API_ENABLED=false
