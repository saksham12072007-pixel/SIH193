APP_NAME="Crop Advisory Backend"
APP_ENV="development"
APP_DEBUG=true
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/crop_advisory"
SECRET_KEY="change-me-in-production-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
SMS_PROVIDER="mock"
SMS_SENDER_ID="TESTSMS"
IVR_PROVIDER="mock"
# Twilio production settings (keep these in deployment secrets, never source control).
# Set SMS_PROVIDER=twilio after the account, sender, and public callback are approved.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_VOICE_FROM=""
TWILIO_STATUS_CALLBACK_URL="https://api.example.gov/sms/webhook/delivery"
ML_API_ENABLED=true
ML_API_URL="https://nir-api.onrender.com"
ML_API_KEY=""
ML_API_TIMEOUT_SECONDS=10
# Optional deployment/model tag; if omitted, the API response version is used.
ML_API_MODEL_VERSION=""
FRONTEND_ALLOWED_ORIGINS="http://localhost:5050,http://127.0.0.1:5050,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000"
INGESTION_PROVIDER="mock"
GEE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""
GEE_SERVICE_ACCOUNT=""
INGESTION_LOOKBACK_DAYS=30
# In-process background scheduler that periodically runs ingest+predict for
# all active plots. Leave off unless this instance owns the pipeline cadence
# (e.g. a single always-on deployment, not one process per worker/replica).
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60
